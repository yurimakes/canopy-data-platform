{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://canopy.example/schemas/engagement/reward_response.schema.json",
  "title": "Canopy weekly reward read response",
  "type": "object",
  "additionalProperties": false,
  "required": ["campaign_id", "week_start", "week_end", "status", "total_points", "updated_at", "policy_version", "finalized", "entries", "next_cursor"],
  "properties": {
    "campaign_id": {"type": "string", "minLength": 1},
    "week_start": {"type": "string", "format": "date"},
    "week_end": {"type": "string", "format": "date"},
    "status": {"enum": ["processing", "settled", "empty"]},
    "total_points": {"type": "number"},
    "updated_at": {"type": "string", "format": "date-time"},
    "policy_version": {"type": ["string", "null"]},
    "finalized": {"type": "boolean"},
    "next_cursor": {"type": ["string", "null"]},
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["reward_id", "label", "points", "status", "occurred_at"],
        "properties": {
          "reward_id": {"type": "string", "minLength": 1},
          "label": {"type": "string", "minLength": 1},
          "points": {"type": "number"},
          "status": {"enum": ["processing", "paid", "adjusted"]},
          "occurred_at": {"type": "string", "format": "date-time"}
        }
      }
    }
  }
}
