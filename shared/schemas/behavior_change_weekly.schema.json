{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "canopy.behavior-change-weekly.v2",
  "title": "Canopy Behavior Change Weekly v2",
  "description": "Mission-independent weekly observed carbon reduction versus the user's ready Personal Baseline for the same evaluation week.",
  "type": "object",
  "required": [
    "user_id",
    "campaign_id",
    "week",
    "status",
    "reason",
    "policy_version"
  ],
  "properties": {
    "user_id": {"type": "string", "minLength": 1},
    "campaign_id": {"type": "string", "minLength": 1},
    "week": {"type": "string", "pattern": "^[0-9]{4}-W[0-9]{2}$"},
    "total_distance_m": {"type": ["number", "null"], "minimum": 0},
    "total_kg_co2e": {"type": ["number", "null"], "minimum": 0},
    "weekly_carbon_intensity_g_co2e_per_km": {"type": ["number", "null"], "minimum": 0},
    "reference_personal_baseline_g_co2e_per_km": {"type": ["number", "null"], "minimum": 0},
    "reduction_g_co2e_per_km": {"type": ["number", "null"]},
    "reduction_rate": {"type": ["number", "null"]},
    "status": {"type": "string", "enum": ["changed", "no_change", "insufficient_data"]},
    "reason": {"type": "string", "minLength": 1},
    "policy_version": {"type": "string", "const": "behavior-change-policy-v2"},
    "baseline_policy_version": {"type": ["string", "null"]},
    "eligibility_policy_version": {"type": ["string", "null"]},
    "carbon_policy_version": {"type": ["string", "null"]},
    "factor_version": {"type": ["string", "null"]},
    "generated_at": {"type": ["string", "null"]}
  },
  "allOf": [
    {
      "if": {"properties": {"status": {"const": "changed"}}},
      "then": {
        "required": [
          "weekly_carbon_intensity_g_co2e_per_km",
          "reference_personal_baseline_g_co2e_per_km",
          "reduction_g_co2e_per_km"
        ]
      }
    }
  ],
  "additionalProperties": true
}
