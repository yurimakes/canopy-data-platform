{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "canopy.trip.v1",
  "title": "Trip API and persisted result",
  "type": "object",
  "description": "Cosmos canopy-db/trips: id=trip_id, partition key /user_id. Extends the team's Cosmos schema with lifecycle status and processor fields; legacy records are not migrated.",
  "required": ["trip_id", "user_id", "campaign_id", "status", "started_at", "ended_at", "created_at", "updated_at", "segments", "model_version", "failed_step", "error_message"],
  "properties": {
    "trip_id": {"type": "string", "minLength": 1},
    "user_id": {"type": "string", "minLength": 1},
    "campaign_id": {"type": "string", "minLength": 1},
    "carbon": {"type": ["object", "null"], "description": "null until the carbon calculation stage is connected; never a fabricated zero"},
    "planned_route": {"type": ["object", "null"], "description": "No planned route is invented for GPS-only collection"},
    "status": {"enum": ["collecting", "processing", "ready", "failed"]},
    "started_at": {"type": "string", "format": "date-time"},
    "ended_at": {"type": ["string", "null"], "format": "date-time"},
    "created_at": {"type": "string", "format": "date-time"},
    "updated_at": {"type": "string", "format": "date-time"},
    "model_version": {"type": ["string", "null"]},
    "failed_step": {"type": ["string", "null"]},
    "error_message": {"type": ["string", "null"]},
    "is_mock": {"type": "boolean"},
    "segments": {"type": "array", "maxItems": 1000, "items": {"$ref": "#/$defs/segment"}}
  },
  "$defs": {
    "segment": {
      "type": "object",
      "required": ["segment_id", "mode", "start_time", "end_time", "distance_m", "confidence"],
      "properties": {
        "segment_id": {"type": "string", "minLength": 1},
        "mode": {"enum": ["walk", "bike", "car", "bus", "rail"]},
        "model_prediction": {"enum": ["walk", "bike", "car", "bus", "rail"], "description": "Immutable original prediction, copied from processor mode"},
        "confirmed_mode": {"enum": [null, "walk", "bike", "car", "bus", "rail"]},
        "corrected": {"type": "boolean"},
        "correction_status": {"enum": ["none", "pending_review", "reviewed"]},
        "confirmation_time": {"type": ["string", "null"], "format": "date-time"},
        "last_request_id": {"type": ["string", "null"]},
        "start_name": {"type": ["string", "null"]},
        "end_name": {"type": ["string", "null"]},
        "route_name": {"type": ["string", "null"]},
        "started_at": {"type": "string", "format": "date-time"},
        "ended_at": {"type": "string", "format": "date-time"},
        "duration_min": {"type": "number", "minimum": 0},
        "start_time": {"type": "string", "format": "date-time"},
        "end_time": {"type": "string", "format": "date-time"},
        "distance_m": {"type": "number", "minimum": 0},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1}
      }
    }
  }
}
