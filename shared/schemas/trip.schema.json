{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "canopy.trip.v1",
  "title": "Trip API and persisted result",
  "type": "object",
  "required": ["trip_id", "user_id", "status", "started_at", "ended_at", "created_at", "updated_at", "segments", "model_version", "failed_step", "error_message"],
  "properties": {
    "trip_id": {"type": "string", "minLength": 1},
    "user_id": {"type": "string", "minLength": 1},
    "status": {"enum": ["collecting", "processing", "ready", "failed"]},
    "started_at": {"type": "string", "format": "date-time"},
    "ended_at": {"type": ["string", "null"], "format": "date-time"},
    "created_at": {"type": "string", "format": "date-time"},
    "updated_at": {"type": "string", "format": "date-time"},
    "model_version": {"type": ["string", "null"]},
    "failed_step": {"type": ["string", "null"]},
    "error_message": {"type": ["string", "null"]},
    "is_mock": {"type": "boolean"},
    "segments": {"type": "array", "maxItems": 1000, "items": {"$ref": "#/$defs/segment"}}
  },
  "$defs": {
    "segment": {
      "type": "object",
      "required": ["segment_id", "mode", "start_time", "end_time", "distance_m", "confidence"],
      "properties": {
        "segment_id": {"type": "string", "minLength": 1},
        "mode": {"enum": ["walk", "bike", "car", "bus", "rail"]},
        "start_time": {"type": "string", "format": "date-time"},
        "end_time": {"type": "string", "format": "date-time"},
        "distance_m": {"type": "number", "minimum": 0},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1}
      }
    }
  }
}
