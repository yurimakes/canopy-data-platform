CANOPY_GPS_API_URL=https://YOUR_FUNCTION_APP_HOST/api/gps
CANOPY_GPS_FUNCTION_KEY=
# Optional: override the app.json bundle identifier for your Apple team.
# CANOPY_IOS_BUNDLE_IDENTIFIER=kr.canopy.gpscollector
CANOPY_TRIP_API_URL=
# Test access token only. Future login supplies a fresh user token to tripConfig().
CANOPY_TRIP_ACCESS_TOKEN=
# May reuse the existing host key; a GPS-specific function key will not authorize Trip routes.
CANOPY_TRIP_FUNCTION_KEY=
CANOPY_TRIP_ALLOW_LOCAL_HTTP=false

# Weekly mission / reward / ranking read APIs. If omitted, the Trip API host is reused.
CANOPY_ENGAGEMENT_API_URL=
CANOPY_ENGAGEMENT_ACCESS_TOKEN=
CANOPY_ENGAGEMENT_FUNCTION_KEY=
CANOPY_ENGAGEMENT_ALLOW_LOCAL_HTTP=false
# Use deterministic mission/reward/ranking fixtures while the read APIs are being integrated.
CANOPY_ENGAGEMENT_USE_MOCK=true
