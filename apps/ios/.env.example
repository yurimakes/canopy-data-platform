CANOPY_GPS_API_URL=https://YOUR_FUNCTION_APP_HOST/api/gps
CANOPY_GPS_FUNCTION_KEY=
# Optional: override the app.json bundle identifier for your Apple team.
# CANOPY_IOS_BUNDLE_IDENTIFIER=kr.canopy.gpscollector
CANOPY_TRIP_API_URL=
# 사용자 토큰은 서버 로그인 후 SecureStore에 저장. 공용 테스트 토큰 사용 제외.
# May reuse the existing host key; a GPS-specific function key will not authorize Trip routes.
CANOPY_TRIP_FUNCTION_KEY=
CANOPY_TRIP_ALLOW_LOCAL_HTTP=false

# Authenticated Canopy proxy. TMAP key belongs on the server only.
CANOPY_ROUTE_API_URL=

# Points-based weekly Ranking API (dev Function App).
CANOPY_RANKING_API_URL=
CANOPY_RANKING_FUNCTION_KEY=
# Optional development override for a dedicated validation campaign/week.
CANOPY_RANKING_CAMPAIGN_ID=
CANOPY_RANKING_WEEK=
