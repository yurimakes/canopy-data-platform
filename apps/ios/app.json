{
  "expo": {
    "name": "Canopy",
    "slug": "canopy-gps-collector",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "kr.canopy.gpscollector",
      "infoPlist": {
        "UIBackgroundModes": [
          "location"
        ],
        "ITSAppUsesNonExemptEncryption": false
      },
      "buildNumber": "8"
    },
    "plugins": [
      "expo-sqlite",
      [
        "expo-location",
        {
          "isIosBackgroundLocationEnabled": true,
          "locationWhenInUsePermission": "이동수단 학습용 GPS 데이터를 수집하기 위해 위치 접근이 필요합니다.",
          "locationAlwaysAndWhenInUsePermission": "측정 중 화면을 잠그거나 다른 앱을 사용해도 이동 기록을 저장하려면 항상 위치 접근이 필요합니다."
        }
      ],
      "expo-sharing",
      "expo-secure-store"
    ],
    "extra": {
      "localOnly": false,
      "routeApiUrl": "",
      "gpsApiUrl": "",
      "gpsFunctionKey": "",
      "tripApiUrl": "",
      "tripFunctionKey": "",
      "tripAllowLocalHttp": false,
      "eas": {
        "projectId": "ff471472-f120-4d84-9835-62ce24c81ab8"
      }
    },
    "owner": "haydens2hn",
    "icon": "./assets/canopy-app-icon.png"
  }
}
