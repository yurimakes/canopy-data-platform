# 로컬 API 개발용 예시
APP_ENV=development
API_HOST=0.0.0.0
API_PORT=8000

# Local only. Generate a different token for each test user; minimum 24 characters.
TRIP_STORE=sqlite
TRIP_SQLITE_PATH=.local-data/trips.sqlite
TRIP_AUTH_MODE=local
TRIP_LOCAL_TOKENS={}
TRIP_PROCESSOR=mock
# Phone confirmation fixture (synthetic 500m walk / 6200m bus / 300m walk):
# TRIP_PROCESSOR=services.mock_trip_processor:ConfirmationFixtureProcessor
# Real ML integration: replace only this value with module:Class implementing
# services.trip_processor.TripProcessor.process_trip -> ProcessorResult/FinalSegment.
TRIP_CAMPAIGN_ID=local-test
TRIP_PROCESS_DELAY_SECONDS=5
# Start processing inside stop immediately. The timer below is crash recovery only.
TRIP_PROCESS_ON_STOP=true
# Explicit Trip end outbox. Reuses the existing GPS Event Hub with Managed Identity.
TRIP_END_EVENTS_ENABLED=false
EVENTHUB_FQDN=
EVENTHUB_NAME=
# functions runs the local processor; databricks delegates after Event Hubs receipt.
TRIP_RESULT_OWNER=functions
# Enable only with the existing Job and Managed Identity permissions configured.
TRIP_DATABRICKS_ENABLED=false
TRIP_DATABRICKS_HOST=
TRIP_DATABRICKS_JOB_ID=
# mock is restricted to pipeline_test_ campaigns and isolated Gold paths.
TRIP_DATABRICKS_INPUT=ml
TRIP_EVENTHUB__fullyQualifiedNamespace=
TRIP_EVENTHUB__credential=managedidentity
TRIP_EVENTHUB_CONSUMER_GROUP=canopy-trip-finalization
TRIP_PROCESS_LEASE_SECONDS=900
TRIP_WORKER_SCHEDULE=*/30 * * * * *

# Azure: TRIP_STORE=cosmos, TRIP_AUTH_MODE=jwt, APP_ENV=production.
# Reuse the team's Managed Identity settings and confirmed container/partition.
COSMOS_ENDPOINT=
COSMOS_TRIPS_DATABASE=canopy-db
COSMOS_TRIPS_CONTAINER=trips
COSMOS_FEEDBACK_CONTAINER=trip_feedback
TRIP_JWT_ISSUER=
TRIP_JWT_AUDIENCE=
TRIP_JWKS_URL=
TRIP_USER_ID_CLAIM=sub

# Optional internal Azure test only: APP_ENV=test, TRIP_AUTH_MODE=test.
# Map user IDs to SHA-256 token digests and Unix expiry times. Never commit actual tokens.
TRIP_TEST_CREDENTIALS={}

# TMAP transit key. Server only; never put this key in the mobile app.
TMAP_APP_KEY=

# 선택: 검색 전용 키가 있을 때만 지정. 비어 있으면 TMAP_APP_KEY 사용
TMAP_POI_APP_KEY=

# users 컨테이너 계정 로그인. 기존 컨테이너와 Managed Identity 사용.
CANOPY_ACCOUNT_AUTH_ENABLED=false
# 비어 있으면 TEST -> TRIP_CAMPAIGN_ID만 허용. 코드와 모집 기간은 서버에서 관리.
# 추후 캠페인 추가 예시 (실제 캠페인 ID로 설정):
# CANOPY_CAMPAIGNS_JSON={"TEST":{"campaign_id":"campaign_test","accepting_signups":true},"TEAM2027":{"campaign_id":"campaign_team_2027","accepting_signups":true,"signup_starts_at":"2027-01-01T00:00:00+09:00","signup_ends_at":"2027-02-01T00:00:00+09:00"}}
CANOPY_CAMPAIGNS_JSON=
