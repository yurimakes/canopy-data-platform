# 로컬 API 개발용 예시
APP_ENV=development
API_HOST=0.0.0.0
API_PORT=8000

# Local only. Generate a different token for each test user; minimum 24 characters.
TRIP_STORE=sqlite
TRIP_SQLITE_PATH=.local-data/trips.sqlite
TRIP_AUTH_MODE=local
TRIP_LOCAL_TOKENS={}
TRIP_PROCESSOR=mock
TRIP_PROCESS_DELAY_SECONDS=5
TRIP_PROCESS_LEASE_SECONDS=900
TRIP_WORKER_SCHEDULE=*/30 * * * * *

# Azure: TRIP_STORE=cosmos, TRIP_AUTH_MODE=jwt, APP_ENV=production.
# Reuse the team's Managed Identity settings and confirmed container/partition.
COSMOS_ENDPOINT=
COSMOS_DATABASE=
COSMOS_TRIPS_CONTAINER=
COSMOS_TRIPS_PARTITION_FIELD=
TRIP_JWT_ISSUER=
TRIP_JWT_AUDIENCE=
TRIP_JWKS_URL=
TRIP_USER_ID_CLAIM=sub
