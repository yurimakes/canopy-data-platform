# 로컬 API 개발용 예시
APP_ENV=development
API_HOST=0.0.0.0
API_PORT=8000

# TMAP 대중교통 길찾기
TMAP_APP_KEY=

# 탄소 배출계수 파일. 운영에서는 팀 승인된 파일만 사용합니다.
CARBON_FACTOR_FILE=../../data/reference/carbon_factors.template.json
ALLOW_UNAPPROVED_CARBON_FACTORS=false

# ODsay는 Postman/백엔드 호출 시 Server key + 등록된 공인 IP가 필요합니다.
# ODSAY_SERVER_API_KEY=

# 필요 시 실제 사용하는 서비스만 추가
# AZURE_STORAGE_ACCOUNT=
# MODEL_ENDPOINT_URL=
