{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "canopy.confirmed-trip.v1",
  "title": "Confirmed Trip for downstream weekly aggregation",
  "description": "Stored at trips.confirmed_trip in canopy-db/trips, partition /user_id. Read the latest revision once per user_id/trip_id; corrections replace that contribution, never append another Trip. Use the team's reporting timezone and week assignment policy with the supplied started_at/ended_at. Exclude is_mock=true from production aggregation. Weekly grouping and eligibility are separate work.",
  "type": "object",
  "required": ["schema_version", "trip_id", "user_id", "campaign_id", "started_at", "ended_at", "confirmed_at", "revision", "confirmation_status", "total_distance_m", "total_carbon_kg", "walk_distance_m", "bike_distance_m", "car_distance_m", "bus_distance_m", "rail_distance_m", "carbon_unit", "carbon_policy_version", "factor_version", "mode_source", "is_mock", "model_version"],
  "properties": {
    "schema_version": {"const": "canopy.confirmed-trip.v1"},
    "trip_id": {"type": "string", "minLength": 1},
    "user_id": {"type": "string", "minLength": 1},
    "campaign_id": {"type": ["string", "null"]},
    "started_at": {"type": "string", "format": "date-time"},
    "ended_at": {"type": "string", "format": "date-time"},
    "confirmed_at": {"type": "string", "format": "date-time"},
    "revision": {"type": "integer", "minimum": 1},
    "confirmation_status": {"const": "confirmed"},
    "total_distance_m": {"type": "number", "minimum": 0},
    "total_carbon_kg": {"type": "number", "minimum": 0},
    "walk_distance_m": {"type": "number", "minimum": 0},
    "bike_distance_m": {"type": "number", "minimum": 0},
    "car_distance_m": {"type": "number", "minimum": 0},
    "bus_distance_m": {"type": "number", "minimum": 0},
    "rail_distance_m": {"type": "number", "minimum": 0},
    "carbon_unit": {"const": "kgCO2e"},
    "carbon_policy_version": {"type": "string"},
    "factor_version": {"type": "string"},
    "mode_source": {"enum": ["confirmed_mode", "model_prediction"]},
    "confirmation_source": {"enum": ["system", "user"]},
    "is_mock": {"type": "boolean"},
    "model_version": {"type": "string"}
  }
}
