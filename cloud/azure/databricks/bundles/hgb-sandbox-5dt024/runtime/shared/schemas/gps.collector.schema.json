{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Canopy GPS common contract v0.2 with v0.1 read compatibility",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_version",
    "event_id",
    "user_id",
    "device_id",
    "trip_id",
    "sequence",
    "event_time",
    "received_at",
    "lat",
    "lon",
    "accuracy",
    "speed",
    "altitude_m",
    "vertical_accuracy_m",
    "course_deg",
    "source",
    "quality_flags",
    "raw_location"
  ],
  "properties": {
    "schema_version": {
      "enum": [
        "canopy.gps.collector.v0.1",
        "canopy.gps.collector.v0.2"
      ]
    },
    "event_id": {
      "type": "string",
      "format": "uuid"
    },
    "user_id": {
      "type": "string",
      "format": "uuid"
    },
    "device_id": {
      "type": "string",
      "format": "uuid"
    },
    "trip_id": {
      "type": "string",
      "format": "uuid"
    },
    "sequence": {
      "type": "integer",
      "minimum": 1
    },
    "event_time": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "received_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "lat": {
      "type": "number",
      "minimum": -90,
      "maximum": 90
    },
    "lon": {
      "type": "number",
      "minimum": -180,
      "maximum": 180
    },
    "accuracy": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0
    },
    "speed": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0
    },
    "altitude_m": {
      "type": [
        "number",
        "null"
      ]
    },
    "vertical_accuracy_m": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0
    },
    "course_deg": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0,
      "exclusiveMaximum": 360
    },
    "source": {
      "enum": [
        "expo-location.foreground",
        "expo-location.background"
      ]
    },
    "quality_flags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "raw_location": {
      "type": "object",
      "additionalProperties": true
    },
    "label": {
      "enum": [
        "walk",
        "bike",
        "car",
        "bus",
        "rail",
        "walking",
        "cycling",
        "subway",
        null
      ],
      "description": "v0.2: developer uses walk/bike/car/bus/rail; user uses explicit null. Old values are v0.1 only."
    },
    "collection_mode": {
      "enum": [
        "user",
        "developer"
      ]
    }
  },
  "allOf": [
    {
      "else": {
        "properties": {
          "label": {
            "enum": [
              "walking",
              "cycling",
              "car",
              "bus",
              "subway"
            ]
          }
        }
      },
      "if": {
        "properties": {
          "schema_version": {
            "const": "canopy.gps.collector.v0.2"
          }
        }
      },
      "then": {
        "oneOf": [
          {
            "properties": {
              "label": {
                "type": "null"
              },
              "collection_mode": {
                "const": "user"
              }
            }
          },
          {
            "properties": {
              "label": {
                "enum": [
                  "walk",
                  "bike",
                  "car",
                  "bus",
                  "rail"
                ]
              },
              "collection_mode": {
                "const": "developer"
              }
            }
          }
        ],
        "required": [
          "collection_mode",
          "label"
        ]
      }
    }
  ]
}
