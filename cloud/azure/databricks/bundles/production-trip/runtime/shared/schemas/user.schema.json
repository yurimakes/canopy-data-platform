{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://canopy.local/schemas/user.schema.json",
  "title": "Canopy user profile",
  "description": "canopy-db/users, partition /user_id. id equals user_id. One current campaign per user. Registration with a campaign sets created_at and campaign_joined_at to the same server timestamp. Preserve both timestamps on retries and later Trips. Eligibility separately checks observation duration and minimum Trip count. Never infer participation from GPS or accept client-supplied dates. Server account credentials use salted PBKDF2-HMAC-SHA256 with 600000 iterations. Sessions store token digests only. Never include credentials, sessions or login_failures in client responses or analytics exports. Existing test users without credentials remain unchanged.",
  "type": "object",
  "required": [
    "id",
    "user_id",
    "created_at"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "user_id": {
      "type": "string",
      "minLength": 1
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "nickname": {
      "type": [
        "string",
        "null"
      ]
    },
    "auth_subject": {
      "type": [
        "string",
        "null"
      ]
    },
    "campaign_id": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "campaign_joined_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "campaign_left_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "department_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "email": {
      "type": [
        "string",
        "null"
      ]
    },
    "login_name": {
      "type": "string"
    },
    "role": {
      "enum": [
        "user",
        "developer"
      ]
    },
    "account_disabled": {
      "type": "boolean"
    },
    "campaign_code": {
      "type": "string"
    },
    "home": {
      "type": [
        "object",
        "null"
      ]
    },
    "work": {
      "type": [
        "object",
        "null"
      ]
    },
    "credentials": {
      "type": "object",
      "writeOnly": true,
      "required": [
        "algorithm",
        "iterations",
        "salt",
        "hash"
      ],
      "properties": {
        "algorithm": {
          "const": "pbkdf2_sha256"
        },
        "iterations": {
          "const": 600000
        },
        "salt": {
          "type": "string"
        },
        "hash": {
          "type": "string"
        }
      }
    },
    "sessions": {
      "type": "array",
      "writeOnly": true
    },
    "login_failures": {
      "type": "array",
      "writeOnly": true
    }
  },
  "additionalProperties": true,
  "allOf": [
    {
      "if": {
        "required": [
          "campaign_id"
        ],
        "properties": {
          "campaign_id": {
            "type": "string"
          }
        }
      },
      "then": {
        "required": [
          "campaign_joined_at"
        ],
        "properties": {
          "campaign_joined_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "else": {
        "properties": {
          "campaign_joined_at": {
            "type": "null"
          },
          "campaign_left_at": {
            "type": "null"
          }
        }
      }
    }
  ]
}
